PROVIDER_HOST=0.0.0.0
HOST_BIND_ADDRESS=127.0.0.1
# Heroku sets PORT; compose and local `.env` use PROVIDER_PORT. When both are
# present, PORT wins so the image default below does not override Heroku.
PROVIDER_PORT=7001
PROVIDER_PUBLIC_BASE_URL=http://transit-bpp:7001
JOURNEY_SOURCE=fixture
JOURNEY_SOURCE_URL=
JOURNEY_SOURCE_RESPONSE_SCHEMA=/app/schemas/journey-source-response.json
FIXTURE_ROOT=/app/fixtures
TRV11_SCHEMA_ROOT=/app/schemas/ondc_trv11/2.0.1
CALLBACK_TIMEOUT_MS=3000
CONTEXT_TTL=PT30S
# Optional. When unset, the PII-bearing GET /orders/{order_id} route is disabled.
ORDER_INSPECTION_TOKEN=

BAP_ID=bap.transit.localhost
BAP_URI=http://bap-network:5002
BAP_CLIENT_PORT=5001
BAP_NETWORK_PORT=5002

BMTC_BPP_ID=bmtc.bpp.transit.localhost
BMTC_BPP_URI=http://bmtc-bpp-network:6002
BMTC_BPP_CLIENT_PORT=6001
BMTC_BPP_NETWORK_PORT=6002
BMTC_CALLBACK_URL=http://bmtc-bpp-client:6001/on_search
BMTC_WEBHOOK_URL=http://transit-bpp:7001/bmtc/inbound
BMTC_CALLBACK_DELAY_MS=0

BMRCL_BPP_ID=bmrcl.bpp.transit.localhost
BMRCL_BPP_URI=http://bmrcl-bpp-network:6102
BMRCL_BPP_CLIENT_PORT=6101
BMRCL_BPP_NETWORK_PORT=6102
BMRCL_CALLBACK_URL=http://bmrcl-bpp-client:6101/on_search
BMRCL_WEBHOOK_URL=http://transit-bpp:7001/bmrcl/inbound
BMRCL_CALLBACK_DELAY_MS=0

# --- Reserved intercity coach seats ------------------------------------------
# A second domain, TRANSIT.LOCALHOST:INTERCITY at version 0.1.0. It is a local,
# Beckn-shaped string and claims conformance to nothing; see
# docs/reserved-intercity.md section 2. Turning it on means a second registry
# subscription and a second network domain in the registry, which is what the
# gateway routes on, so it is off unless a deployment has made both changes.
RESERVED_ENABLED=false
RESERVED_SCHEMA_ROOT=/app/schemas/transit_local_intercity/0.1.0

KSRTC_BPP_ID=ksrtc.bpp.transit.localhost
KSRTC_BPP_URI=http://ksrtc-bpp-network:6202
KSRTC_BPP_CLIENT_PORT=6201
KSRTC_BPP_NETWORK_PORT=6202
KSRTC_CALLBACK_URL=http://ksrtc-bpp-client:6201/on_search
# The reserved seller's protocol server posts here. The route exists whenever
# RESERVED_ENABLED is true and answers 404 while it is false, so an existing
# deployment that has made neither the registry nor the gateway change boots
# exactly as it did.
KSRTC_WEBHOOK_URL=http://transit-bpp:7001/ksrtc/inbound
KSRTC_CALLBACK_DELAY_MS=0

# Reservations close this many minutes before departure. 45 is the conservative
# end of the operator's own published 30-to-45 minute range: refusing a sale
# this provider might have made costs nothing, and making one an operator would
# have refused is the wrong error.
RESERVATION_CLOSE_MINUTES=45
# How far ahead a date can be booked. Matches the operator's own published
# advance window, but enforced here as a fidelity choice: inventing a seat map
# for a date nobody could book yet is fabrication with extra steps.
RESERVATION_HORIZON_DAYS=30
# The seed every seat-occupancy draw is keyed through. Fixed by default so that
# this repository's tests, a demo recording and a stranger's first clone all
# draw the same coach on the same date. Change it and every seat map changes.
SEAT_OCCUPANCY_SEED=20260905

# How long a hold lasts, absolutely, from the instant this provider takes it.
# Ten minutes is twice the best-documented incumbent figure of five, and the
# departure is deliberate rather than careless: five minutes covers a passenger
# form and a payment, and this window covers a name, an age and a gender per
# seat, twelve fields for a family of four, typed on a phone, with no payment
# step to end it early. On a thirty-berth sleeper a ten-minute hold caps the
# damage one abandoned session can do at 3.3% of the coach for a sixth of an
# hour. If that trade is judged wrong, 300 is the better value and this is the
# one line that changes.
RESERVATION_HOLD_TTL_SECONDS=600

# Where held and booked seats live. A held seat is a shared, finite resource
# rather than a settled fact on a rider's phone, so it has to outlive a
# release: a restart that forgot every hold would release seats somebody is
# mid-checkout on and make "how many seats are left" a function of uptime.
# One file, no extra service. Use :memory: to run without one.
RESERVED_DB_URL=file:/app/data/reserved.db
RESERVED_MIGRATION_ROOT=/app/migrations/reserved

# How long a passenger name outlives its journey. The booking row survives,
# because a rider needs to see that a journey happened; the names do not,
# because nothing needs them once the coach has gone.
RESERVED_MANIFEST_RETENTION_DAYS=30

# Where the reserved catalogue comes from. `fixture` reads fixtures/ksrtc and
# needs nothing else running, which is what makes a fresh clone work. `http`
# reads a dataset over the contract in docs/reserved-source-http.md, with the
# fixtures still underneath it as the fallback.
RESERVED_SOURCE=fixture
# RESERVED_SOURCE_URL=http://dataset:9000/reserved

# Where a confirm or a cancellation pushes the seat count that changed -
# transit-fleet-sim's PUT/DELETE /fleet/manifest (docs/intercity-coaches.md
# section 7.4 in that repository). No default: unset means this provider
# builds an inert publisher and pushes nothing, rather than guessing a port
# nobody asked it to reach. FLEET_MANIFEST_TOKEN is that service's own
# MANIFEST_TOKEN, a different credential from anything this provider issues.
# FLEET_MANIFEST_URL=http://fleet-sim:8080
# FLEET_MANIFEST_TOKEN=
FLEET_MANIFEST_TTL_SECONDS=3600

SEARCH_TTL=PT4S
