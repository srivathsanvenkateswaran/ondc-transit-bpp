{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transit.localhost/schemas/transit-local-intercity/0.1.0/search.json",
  "$comment": "A reserved search names two towns and a travel date. It does not name boarding points: a rider searching one town to another has not chosen a pickup yet, and the boarding-point choice is a consequence of the service.",
  "type": "object",
  "required": [
    "context",
    "message"
  ],
  "properties": {
    "context": {
      "type": "object",
      "required": [
        "domain",
        "location",
        "action",
        "version",
        "bap_id",
        "bap_uri",
        "transaction_id",
        "message_id",
        "timestamp",
        "ttl"
      ],
      "properties": {
        "domain": {
          "const": "TRANSIT.LOCALHOST:INTERCITY"
        },
        "location": {
          "type": "object",
          "required": [
            "country",
            "city"
          ],
          "properties": {
            "country": {
              "type": "object",
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "const": "IND"
                }
              }
            },
            "city": {
              "type": "object",
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "action": {
          "const": "search"
        },
        "version": {
          "const": "0.1.0"
        },
        "bap_id": {
          "type": "string",
          "minLength": 1
        },
        "bap_uri": {
          "type": "string",
          "minLength": 1
        },
        "bpp_id": {
          "type": "string",
          "minLength": 1
        },
        "bpp_uri": {
          "type": "string",
          "minLength": 1
        },
        "transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "ttl": {
          "type": "string",
          "pattern": "^P"
        }
      }
    },
    "message": {
      "type": "object",
      "required": [
        "intent"
      ],
      "properties": {
        "intent": {
          "type": "object",
          "required": [
            "category",
            "fulfillment"
          ],
          "properties": {
            "category": {
              "type": "object",
              "required": [
                "descriptor"
              ],
              "properties": {
                "descriptor": {
                  "type": "object",
                  "required": [
                    "code"
                  ],
                  "properties": {
                    "code": {
                      "const": "RESERVED"
                    }
                  }
                }
              }
            },
            "fulfillment": {
              "$comment": "travel_date is mandatory. A reserved search with no travel date is refused with TRAVEL-DATE-REQUIRED rather than defaulting to today: defaulting to today is the silent discard this field exists to prevent.",
              "type": "object",
              "required": [
                "stops",
                "travel_date"
              ],
              "properties": {
                "travel_date": {
                  "$ref": "https://transit.localhost/schemas/transit-local-intercity/0.1.0/common.json#/$defs/travelDate"
                },
                "stops": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "required": [
                      "type",
                      "location"
                    ],
                    "properties": {
                      "type": {
                        "enum": [
                          "START",
                          "END"
                        ]
                      },
                      "location": {
                        "type": "object",
                        "required": [
                          "descriptor"
                        ],
                        "properties": {
                          "descriptor": {
                            "$ref": "https://transit.localhost/schemas/transit-local-intercity/0.1.0/common.json#/$defs/codeDescriptor"
                          }
                        }
                      }
                    }
                  }
                },
                "vehicle": {
                  "type": "object",
                  "required": [
                    "category"
                  ],
                  "properties": {
                    "category": {
                      "const": "COACH"
                    }
                  }
                }
              }
            },
            "item": {
              "$comment": "An optional class filter.",
              "type": "object",
              "required": [
                "descriptor"
              ],
              "properties": {
                "descriptor": {
                  "$ref": "https://transit.localhost/schemas/transit-local-intercity/0.1.0/common.json#/$defs/codeDescriptor"
                }
              }
            }
          }
        }
      }
    }
  }
}
