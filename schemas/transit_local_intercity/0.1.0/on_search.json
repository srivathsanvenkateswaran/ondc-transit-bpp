{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transit.localhost/schemas/transit-local-intercity/0.1.0/on_search.json",
  "$comment": "A refused search answers with an error and no catalog, exactly as the other five callbacks do. This document required `message.catalog` unconditionally, which meant a search this provider refuses - two stops of the same type, say, which the request schema admits and `reservedSearchQuery` rejects - produced a callback that failed this schema and was therefore never sent. The client had no answer at all. A callback that cannot express a refusal is a callback that sometimes sends nothing.",
  "type": "object",
  "required": [
    "context"
  ],
  "anyOf": [
    {
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "object",
          "required": [
            "catalog"
          ]
        }
      }
    },
    {
      "required": [
        "error"
      ]
    }
  ],
  "properties": {
    "context": {
      "allOf": [
        {
          "$ref": "https://transit.localhost/schemas/transit-local-intercity/0.1.0/common.json#/$defs/context"
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "on_search"
            }
          }
        }
      ]
    },
    "message": {
      "type": "object",
      "properties": {
        "catalog": {
          "type": "object",
          "required": [
            "descriptor",
            "providers"
          ],
          "properties": {
            "descriptor": {
              "$ref": "https://transit.localhost/schemas/transit-local-intercity/0.1.0/common.json#/$defs/descriptor"
            },
            "providers": {
              "type": "array",
              "items": {
                "$ref": "https://transit.localhost/schemas/transit-local-intercity/0.1.0/common.json#/$defs/provider"
              }
            }
          }
        }
      }
    },
    "error": {
      "$ref": "https://transit.localhost/schemas/transit-local-intercity/0.1.0/common.json#/$defs/error"
    }
  }
}
