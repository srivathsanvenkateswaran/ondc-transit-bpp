{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transit.localhost/schemas/transit-local-intercity/0.1.0/on_select.json",
  "$comment": "Either an order or an error, never both and never neither. A domain error - a locked seat, a lapsed hold, a missing fare - arrives here with no message.order.",
  "type": "object",
  "required": [
    "context"
  ],
  "anyOf": [
    {
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "object",
          "required": [
            "order"
          ]
        }
      }
    },
    {
      "required": [
        "error"
      ]
    }
  ],
  "properties": {
    "context": {
      "allOf": [
        {
          "$ref": "https://transit.localhost/schemas/transit-local-intercity/0.1.0/common.json#/$defs/context"
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "on_select"
            }
          }
        }
      ]
    },
    "message": {
      "type": "object",
      "properties": {
        "order": {
          "$ref": "https://transit.localhost/schemas/transit-local-intercity/0.1.0/common.json#/$defs/baseOrder"
        },
        "tags": {
          "$comment": "A refusal carries what a client needs to act on it, beside the error rather than on an order: a select refused because somebody else took the seat comes back with the current seat map, so the loser can re-render without a second round trip. It is not an order, because a refused select produced none.",
          "type": "array",
          "items": {
            "$ref": "https://transit.localhost/schemas/transit-local-intercity/0.1.0/common.json#/$defs/tag"
          }
        }
      }
    },
    "error": {
      "$ref": "https://transit.localhost/schemas/transit-local-intercity/0.1.0/common.json#/$defs/error"
    }
  }
}
