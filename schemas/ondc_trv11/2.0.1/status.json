{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ondc.local/schemas/ondc-trv11/2.0.1/status.json",
  "type": "object",
  "required": ["context", "message"],
  "properties": {
    "context": {
      "allOf": [
        { "$ref": "https://ondc.local/schemas/ondc-trv11/2.0.1/common.json#/$defs/context" },
        { "type": "object", "properties": { "action": { "const": "status" } } }
      ]
    },
    "message": {
      "type": "object",
      "oneOf": [
        { "required": ["order_id"] },
        { "required": ["ref_id"] }
      ],
      "properties": {
        "order_id": { "type": "string", "minLength": 1 },
        "ref_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
