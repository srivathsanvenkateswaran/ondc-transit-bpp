{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ondc.local/schemas/ondc-trv11/2.0.1/on_init.json",
  "type": "object",
  "required": ["context"],
  "oneOf": [{ "required": ["message"] }, { "required": ["error"] }],
  "properties": {
    "context": {
      "allOf": [
        { "$ref": "https://ondc.local/schemas/ondc-trv11/2.0.1/common.json#/$defs/context" },
        { "type": "object", "properties": { "action": { "const": "on_init" } } }
      ]
    },
    "message": {
      "type": "object",
      "required": ["order"],
      "properties": {
        "order": {
          "allOf": [
            {
              "$ref": "https://ondc.local/schemas/ondc-trv11/2.0.1/common.json#/$defs/baseOrder"
            },
            {
              "type": "object",
              "required": ["billing", "payments"]
            }
          ]
        }
      }
    },
    "error": {
      "$ref": "https://ondc.local/schemas/ondc-trv11/2.0.1/common.json#/$defs/error"
    }
  }
}
